#!/usr/bin/env python3
"""CLI adapter fixture. Its only mutable files live beside the injected socket."""
import json
import os
from pathlib import Path
import sys
import time

root = Path(os.environ['HERDR_SOCKET_PATH']).parent
settings = json.loads((root / 'fake.json').read_text())
args = sys.argv[1:]
if settings.get('offline'):
    print(json.dumps({'id': 'fixture', 'error': {'code': 'server_not_running', 'message': 'fixture transport unavailable'}}), file=sys.stderr)
    sys.exit(1)
if args == ['workspace', 'list']:
    (root / 'discovery.pid').write_text(str(os.getpid()))
    time.sleep(settings.get('discovery_delay', 0))
    if settings.get('bad_discovery'):
        print('{}')
    else:
        print(json.dumps({'id': 'fixture', 'result': {'workspaces': [
            {'workspace_id': w} for w in settings['workspaces']
        ]}}))
elif args == ['pane', 'list']:
    print(json.dumps({'id': 'fixture', 'result': {'panes': [
        {'workspace_id': w, 'cwd': path} for w, path in settings['workspaces'].items()
    ]}}))
elif args[:2] == ['workspace', 'report-metadata']:
    (root / 'report.pid').write_text(str(os.getpid()))
    time.sleep(settings.get('report_delay', 0))
    with (root / 'reports.jsonl').open('a') as log:
        log.write(json.dumps({'args': args, 'time': time.time()}) + '\n')
    if settings.get('report_error'):
        print(json.dumps({'id': 'fixture', 'error': {'code': settings['report_error'], 'message': 'DO_NOT_LOG_RAW_SECRET'}}), file=sys.stderr)
        sys.exit(1)
    # Herdr's mutation success has empty stdout.
else:
    sys.exit(2)
